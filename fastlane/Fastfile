default_platform(:ios)

# ASC credentials come from prod.env (gitignored) — `source prod.env` before
# running fastlane. The key must belong to the Tangzixiang provider (team
# 32B45SMMQL): keys from other providers cannot see com.david.fkad.
def asc_api_key
  %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].each do |var|
    UI.user_error!("#{var} is not set — run `source prod.env` first") if ENV[var].to_s.empty?
  end
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"],
  )
end

platform :ios do
  desc "Download current App Store metadata (text only) into ./fastlane/metadata"
  lane :pull_metadata do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      run_precheck_before_submit: false,
      force: true,
      overwrite_screenshots: false,
    )
  end

  desc "Upload metadata to App Store Connect (no binary, no screenshots)"
  lane :push_metadata do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
      precheck_include_in_app_purchases: false,
      automatic_release: false,
    )
  end

  desc "Upload screenshots from ./fastlane/screenshots to App Store Connect"
  lane :push_screenshots do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
      overwrite_screenshots: true,
    )
  end
end
